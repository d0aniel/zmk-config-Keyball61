#define DEFAULT 0
#define SYM     1
#define NUM     2
#define MOUSE   3 // Auto-Mouse Layer
#define SCROLL  4 // Motion Scroll Layer
#define SNIPE   5 // Snipe Mode Layer

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <250>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    hold-trigger-on-release;
};

/* Opposite-hand plain-&kp positions only: deliberately excludes SPACE, ENTER
 * (&mt), and A, SEMI (&lt), since letting one hold-tap's resolution depend on
 * another still-unresolved hold-tap is a known source of misfires. */

#define RIGHT_HAND_PLAIN_KEYS  6 7 8 9 10   18 19 20 21 22   30 31   44 45 46 47 48
#define LEFT_HAND_PLAIN_KEYS   1 2 3 4 5    13 14 15 16 17   28 29   37 38 39 40 41

/ {
    behaviors {
        /* Sticky modifier for the home row mods' hold action: applies to the next
         * keypress regardless of whether the mod key is still physically held, so
         * releasing it before pressing the target letter still capitalizes it.
         * quick-release deactivates on the next key's press rather than release,
         * so fast typing after the modified letter doesn't get double-capitalized. */

        sk_hrm: sticky_key_hrm {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
            ignore-modifiers;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&sk_hrm>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <RIGHT_HAND_PLAIN_KEYS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&sk_hrm>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <LEFT_HAND_PLAIN_KEYS>;
            hold-trigger-on-release;
        };

        /* Positional layer-taps for A/SEMI, same reasoning as hml/hmr above: drop
         * require-prior-idle-ms (which was forcing an instant tap during fast
         * typing regardless of hold duration) in favor of resolving hold from an
         * opposite-hand keypress instead. The shared &lt below (TAB/ESCAPE thumb
         * keys) is untouched. */

        lta: layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <RIGHT_HAND_PLAIN_KEYS>;
            hold-trigger-on-release;
        };

        ltr: layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <LEFT_HAND_PLAIN_KEYS>;
            hold-trigger-on-release;
        };
    };
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <25 34>;
            require-prior-idle-ms = <150>;
        };

        back {
            bindings = <&mkp MB4>;
            key-positions = <39 40>;
            require-prior-idle-ms = <200>;
        };

        forward {
            bindings = <&mkp MB5>;
            key-positions = <45 46>;
            require-prior-idle-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&none          &kp N1    &kp N2           &kp N3             &kp N4     &kp N5                                        &kp N6                   &kp N7  &kp N8              &kp N9            &kp N0       &none
&kp DELETE     &kp Q     &kp W            &kp E              &kp R      &kp T                                         &kp Y                    &kp U   &kp I               &kp O             &kp P        &none
&kp BACKSPACE  &lta 2 A  &hml LEFT_ALT S  &hml LEFT_SHIFT D  &kp F      &kp G                                         &kp H                    &kp J   &hmr RIGHT_SHIFT K  &hmr RIGHT_ALT L  &ltr 2 SEMI  &none
&caps_word     &kp Z     &kp X            &kp C              &kp V      &kp B            &kp LEFT_WIN  &kp RIGHT_WIN  &kp N                    &kp M   &kp COMMA           &kp DOT           &kp SLASH    &none
&none          &none     &none            &none              &lt 1 TAB  &mt LCTRL SPACE  &lt 5 ESCAPE  &lt 1 TAB      &mt RIGHT_CONTROL ENTER                                                &none        &mo 6
            >;
        };

        number_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;

            label = "NUM";
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &kp F1      &kp F2          &kp F3      &kp F4       &kp F5                      &kp F6      &kp F7      &kp F8            &kp F9             &kp F10        &kp F11
&trans  &kp LS(N1)  &kp LS(N2)      &kp LS(N3)  &kp LS(N4)   &kp LS(N5)                  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)        &kp LS(N9)         &kp LS(N0)     &kp F12
&trans  &kp EQUAL   &kp UNDERSCORE  &trans      &kp LS(SQT)  &trans                      &trans      &kp APOS    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS      &trans
&trans  &kp PLUS    &kp PIPE        &trans      &trans       &trans      &trans  &trans  &trans      &trans      &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp BACKSLASH  &trans
&trans  &trans      &trans          &trans      &trans       &trans      &trans  &trans  &trans                                                       &trans         &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &kp UP_ARROW  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &kp C_PLAY_PAUSE  &kp C_MUTE   &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans                  &trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &trans  &trans
&trans  &kp C_PREVIOUS    &kp C_NEXT   &trans             &trans           &trans                  &trans  &trans                &trans                &trans  &trans  &trans
&trans  &bt BT_CLR        &trans       &bt BT_PRV         &bt BT_NXT       &trans                  &trans  &trans                &trans                &trans  &trans  &trans
&trans  &sys_reset        &bootloader  &trans             &trans           &trans  &trans  &trans  &trans  &trans                &trans                &trans  &trans  &trans
&trans  &trans            &trans       &trans             &trans           &trans  &trans  &trans  &trans                                                      &trans  &trans
            >;
        };
    };
};
